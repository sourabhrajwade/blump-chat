# --- MongoDB ---
# If your server requires auth, use either a full URI or user + password (email usernames are supported).
#
# Option A — one line (password special chars must be URL-encoded):
# MONGO_URL=mongodb://admin:admin@localhost:27017/?authSource=admin
#
# Option B — email-style user (leave MONGO_URL unset). Password required if your server enforces auth.
MONGO_URL=
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_AUTH_SOURCE=admin

MONGO_DB_NAME=filestore

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
EMBEDDING_DIM=1024

# Inference: ollama (default) uses /api/chat and /api/embed on OLLAMA_BASE_URL.
# Use openai for any OpenAI-compatible API (OpenAI, vLLM, LM Studio, LiteLLM, etc.): /v1/chat/completions + /v1/embeddings
LLM_BACKEND=ollama
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks

RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

OLLAMA_CHAT_MODEL=llama3.2
CHAT_SYSTEM_PROMPT=You are a precise assistant. Use context snippets; if unknown, say you do not know.
CHAT_RETRIEVAL_TOP_K=8
CHAT_MEMORY_MESSAGE_LIMIT=10
LOG_LEVEL=INFO
